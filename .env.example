# Copy file này thành .env và điền giá trị thực
# Expo sử dụng prefix EXPO_PUBLIC_ cho env vars client-side

EXPO_PUBLIC_API_URL=https://api.yourapp.com
EXPO_PUBLIC_APP_ENV=development
BUNDLE_ID=com.yourcompany.studiomanagement

# Deep link / universal link — dùng cho luồng mời kết nối (join/:code)
EXPO_PUBLIC_DEEPLINK_SCHEME=studiomanagement
EXPO_PUBLIC_UNIVERSAL_LINK_HOST=https://studio-management.app
EXPO_PUBLIC_INVITE_PATH=join
# Bật universal link (associatedDomains) — chỉ bật khi có Apple Developer Program trả phí
EXPO_PUBLIC_ENABLE_UNIVERSAL_LINKS=false
